# ─── Huly (Arabic + RTL) — Coolify environment ───────────────────────────────
# Copy these into Coolify → your resource → Environment Variables.

# Public domain you assigned to the `nginx` service in Coolify (NO scheme).
HOST_ADDRESS=huly.example.com

# "s" => build https/wss URLs (use this when Coolify serves the domain over TLS,
# which is the default). Leave empty for plain http (local testing only).
SECURE=s

# Session/token signing secret. MUST be set. Generate one with:
#   openssl rand -hex 32
SECRET=change-me-to-a-64-char-hex-secret

# ─── Arabic images published to GHCR by the build workflow ───────────────────
# Lowercase owner. After the first workflow run, either make the GHCR packages
# public, or add a GHCR pull credential (PAT with read:packages) in Coolify.
HULY_IMAGE_REGISTRY=ghcr.io/nexeon-ai
HULY_IMAGE_TAG=ar

# ─── Database (CockroachDB single-node) ──────────────────────────────────────
CR_DATABASE=defaultdb
CR_USERNAME=root
CR_USER_PASSWORD=
CR_DB_URL=postgresql://root@cockroach:26257/defaultdb?sslmode=disable

# ─── App defaults ────────────────────────────────────────────────────────────
# Default UI language for new sessions — set to Arabic.
DEFAULT_LANGUAGE=ar
TITLE=Huly
LAST_NAME_FIRST=true
